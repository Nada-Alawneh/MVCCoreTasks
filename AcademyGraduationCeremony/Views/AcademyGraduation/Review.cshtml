@model IEnumerable<AcademyGraduationCeremony.Models.Offer>

<h2 class="mb-4">Review Your Request</h2>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Category</th>
            <th>Supplier Name</th>
            <th>Offer Name</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Offer Total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var offer in Model)
        {
            <tr>
                <td>@offer.CategoryName</td>
                <td>@offer.SupplierName</td>
                <td>@offer.OfferName</td>
                <td>@offer.Quantity</td>
                <td>@offer.UnitPrice JD</td>
                <td>@(offer.Quantity * offer.UnitPrice) JD</td>
            </tr>
        }
    </tbody>
</table>

<div class="card mt-4" style="width: 25rem;">
    <div class="card-header bg-primary text-white">
        <h5>Final Bill Summary</h5>
    </div>
    <div class="card-body">
        <p><strong>Total Price:</strong> @ViewBag.TotalPrice JD</p>
        <p><strong>Discount Percentage:</strong> @ViewBag.DiscountPercentage %</p>
        <p class="text-danger"><strong>Discount Amount:</strong> -@ViewBag.DiscountAmount JD</p>
        <hr />
        <h4 class="text-success"><strong>Final Total:</strong> @ViewBag.FinalTotal JD</h4>
    </div>
</div>

<a href="@Url.Action("Index", "AcademyGraduation")" class="btn btn-secondary mt-3">Back to Offers</a>

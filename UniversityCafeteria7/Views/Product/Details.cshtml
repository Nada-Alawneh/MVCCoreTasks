@model Product

<h2>Product Details</h2>

<p>Id: @Html.DisplayFor(m => m.Id)</p>
<p>Name: @Html.DisplayFor(m => m.Name)</p>
<p>Description: @Html.DisplayFor(m => m.Description)</p>
<p>Price: @Html.DisplayFor(m => m.Price)</p>
<p>Quantity: @Html.DisplayFor(m => m.Quantity)</p>
<p>Category ID: @Html.DisplayFor(m => m.CategoryId)</p>
<p>Supplier ID: @Html.DisplayFor(m => m.SupplierId)</p>
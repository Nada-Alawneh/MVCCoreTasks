@model List<Product>

<h2>Products</h2>

<a asp-action="Create">Add New</a>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Supplier</th>
            <th>Category</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Price</td>
                <td>
                    @product.Quantity
                    @if (product.Quantity < 5)
                    {
                        <span>Low Stock</span>
                    }
                </td>
                <td>@product.SupplierId</td>
                <td>@product.CategoryId</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                    <a asp-action="Details" asp-route-id="@product.Id">Details</a>
                    <form asp-action="Delete" asp-route-id="@product.Id" method="post">
                        <button type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
@model List<Order>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Orders</h2>
    @Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-primary" })
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Customer Name</th>
                <th>Total Price</th>
                <th>Status</th>
                <th>Order Date</th>
                <th>Employee Id</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@order.CustomerName</td>
                    <td>@order.TotalPrice</td>
                    <td>@order.Status</td>
                    <td>@order.OrderDate</td>
                    <td>@order.EmployeeId</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            @Html.ActionLink("Edit", "Edit", new { id = order.Id },
                                new { @class = "btn btn-sm btn-outline-primary" })

                            @Html.ActionLink("Details", "Details", new { id = order.Id },
                                new { @class = "btn btn-sm btn-outline-secondary" })

                            @using (Html.BeginForm("Delete", "Order", new { id = order.Id }))
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
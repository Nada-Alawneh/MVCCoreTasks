@model Order

<h2>Order Details</h2>

<p>Customer Name: @Html.DisplayFor(m => m.CustomerName)</p>
<p>Total Price: @Html.DisplayFor(m => m.TotalPrice)</p>
<p>Status: @Html.DisplayFor(m => m.Status)</p>
<p>Order Date: @Html.DisplayFor(m => m.OrderDate)</p>
<p>Employee Id: @Html.DisplayFor(m => m.EmployeeId)</p>
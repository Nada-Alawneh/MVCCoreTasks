@model List<Employee>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Employees</h2>
    @Html.ActionLink("Add New", "Create", null, new { @class = "btn btn-primary" })
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Full Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Position</th>
                <th>Salary</th>
                <th>Hire Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.FullName</td>
                    <td>@employee.Phone</td>
                    <td>@employee.Email</td>
                    <td>@employee.Position</td>
                    <td>@employee.Salary</td>
                    <td>@employee.HireDate</td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            @Html.ActionLink("Edit", "Edit", new { id = employee.Id },
                                new { @class = "btn btn-sm btn-outline-primary" })

                            @Html.ActionLink("Details", "Details", new { id = employee.Id },
                                new { @class = "btn btn-sm btn-outline-secondary" })

                            @using (Html.BeginForm("Delete", "Employee", new { id = employee.Id }))
                            {
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@model Employee

<h2>Employee Details</h2>

<p>Full Name: @Html.DisplayFor(m => m.FullName)</p>
<p>Phone: @Html.DisplayFor(m => m.Phone)</p>
<p>Email: @Html.DisplayFor(m => m.Email)</p>
<p>Position: @Html.DisplayFor(m => m.Position)</p>
<p>Salary: @Html.DisplayFor(m => m.Salary)</p>
<p>Hire Date: @Html.DisplayFor(m => m.HireDate)</p>
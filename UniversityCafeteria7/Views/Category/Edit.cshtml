@model Category

<h2>Edit Category</h2>

<form asp-action="Edit"  asp-controller="Category" method="post">
    <div>
        <label>Name :</label>
        <input type="text" name="Name" value="@Model.Name" />
    </div>

    <div>
        <label>Description</label>
        <input name="Description" value="@Model.Description" />

    </div>

    <button type="submit">Save</button>
</form>
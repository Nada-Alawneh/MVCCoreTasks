
@model Category

<h2>Add Category</h2>

<form asp-action="Create" asp-controller="Category" method="post">
    <div>
        <label>Name :</label>
        <input type="text" name="Name" />
    </div>

    <div>
        <label>Description</label>
        <textarea name="Description"></textarea>

    </div>

    <button type="submit">Save</button>
</form>
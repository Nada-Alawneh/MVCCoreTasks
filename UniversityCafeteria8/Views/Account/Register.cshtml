@model RegisterDTO
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Register";
    var token = Antiforgery.GetAndStoreTokens(Context);
}

<h1>Register</h1>
@foreach (var entry in ViewData.ModelState)
{
    foreach (var error in entry.Value.Errors)
    {
        <p class="text-danger">@error.ErrorMessage</p>
    }
}
<form action="/Account/Register" method="post">
    <input type="hidden" name="@token.FormFieldName" value="@token.RequestToken" />
    <p>
        <label for="FullName">Full name</label>
        <input id="FullName" name="FullName" type="text" autocomplete="name" required value="@Model?.FullName" />
    </p>
    <p>
        <label for="Email">Email</label>
        <input id="Email" name="Email" type="email" autocomplete="email" required value="@Model?.Email" />
    </p>
    <p>
        <label for="Password">Password</label>
        <input id="Password" name="Password" type="password" autocomplete="new-password" required />
    </p>
    <p>
        <label for="ConfirmPassword">Confirm password</label>
        <input id="ConfirmPassword" name="ConfirmPassword" type="password" autocomplete="new-password" required />
    </p>
    <button type="submit">Register</button>
</form>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">University Cafeteria</h1>
    <p>Browse cafeteria products, submit supply requests, and track their status.</p>
    @* رابط البداية حسب حالة تسجيل الدخول. *@
    @if (User.Identity?.IsAuthenticated == true)
    {
        <p><a href="/Account">Go to your account</a></p>
    }
    else
    {
        <p><a href="/Account/Login">Login</a> or <a href="/Account/Register">register</a> to get started.</p>
    }
</div>

@using Microsoft.AspNetCore.Identity
@model IdentityUser
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Change role";
    var token = Antiforgery.GetAndStoreTokens(Context);
    var roles = (List<IdentityRole>)ViewBag.Roles;
}

<h1>Change role</h1>
<p>User: @Model.UserName (@Model.Email)</p>
<p>Current roles: @ViewBag.CurrentRoles</p>

@* بنرسل رقم المستخدم ورقم الدور الجديد للكونترولر. *@
<form action="/Admin/Edit" method="post">
    <input type="hidden" name="@token.FormFieldName" value="@token.RequestToken" />
    <input type="hidden" name="id" value="@Model.Id" />
    <label for="roleId">New role</label>
    <select id="roleId" name="roleId" required>
        <option value="">Select a role</option>
        @foreach (var role in roles)
        {
            <option value="@role.Id">@role.Name</option>
        }
    </select>
    <button type="submit">Save</button>
</form>
<p><a href="/Admin">Back to list</a></p>
